{
  "name": "tactus-web",
  "private": true,
  "description": "Tactus marketing site: Markus content rendered by Papyrus, React islands bundled with esbuild",
  "version": "0.1.0",
  "dependencies": {
    "@anthus/tactus-hitl-components": "github:AnthusAI/Tactus-HITL-components#main",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@remotion/player": "4.0.406",
    "@streamdown/cjk": "^1.0.1",
    "@streamdown/code": "^1.0.1",
    "@streamdown/math": "^1.0.1",
    "@streamdown/mermaid": "^1.0.1",
    "ai": "^6.0.49",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.2",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.19.0",
    "@aws-amplify/backend-cli": "^1.8.1",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react-webpack5": "^10.1.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitest/mocker": "^4.0.17",
    "esbuild": "0.25.12",
    "prettier": "^2.8.8",
    "prop-types": "^15.8.1",
    "storybook": "^10.1.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "scripts": {
    "check:node": "node scripts/ensure-node-20.js",
    "preinstall": "npm run check:node",
    "prebuild": "npm run check:node && npm run examples:ingest && npm run stdlib:ingest && node scripts/build-islands.js",
    "examples:ingest": "node scripts/ingest-examples.js",
    "stdlib:ingest": "node scripts/ingest-stdlib.js",
    "build": "sh bin/publication.sh",
    "videos:render": "node scripts/render-videos.js",
    "videos:upload": "node scripts/upload-videos.js",
    "videos:publish": "npm run videos:render && npm run videos:upload",
    "videos:studio": "npm --prefix videos start",
    "videos:start": "npm --prefix videos start",
    "babulus": "videos/bin/babulus generate videos/content --project-dir videos",
    "babulus:watch": "videos/bin/babulus generate videos/content --watch --project-dir videos",
    "babulus:clean": "videos/bin/babulus clean videos/content --project-dir videos",
    "remotion": "npm run videos:studio",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "test": "sh bin/publication.sh test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve": "python3 -m http.server --directory public 8000"
  },
  "repository": {}
}
