          ]
        },
        {
          "id": "content",
          "zIndex": 0,
          "components": [
            {
              "id": "text-block-0",
              "type": "TextBlock",
              "props": {
                "text": "A safe delegation pattern\\n\\n1) Draft with read-only tools (no side effects).\\n2) Durable human review: approve, edit, reject.\\n3) Only after approval does the send tool become available.",
                "x": 960,
                "y": 600,
                "size": 40,
                "align": "center",
                "maxWidth": 1400,
                "font": "serif",
                "lineHeight": 1.35,
                "sceneStartSec": 277.2
              }
            }
          ]
        }
      ],
      "cues": [
        {
          "id": "recap_emails",
          "label": "recap_emails",
          "startSec": 281.2,
          "endSec": 308.19999999999993,
          "text": "Consider a workflow that drafts and sends recap emails from meeting notes. Without guardrails, you either supervise every run, or you give the agent side-effect tools and accept unacceptable risk. With staged tools and durable approvals, the agent drafts with read-only tools, a human reviews at a checkpoint, and only after approval does the send tool become available.",
          "segments": [
            {
              "type": "tts",
              "startSec": 281.2,
              "endSec": 287.84999999999997,
              "text": "Consider a workflow that drafts and sends recap emails from meeting notes."
            },
            {
              "type": "pause",
              "startSec": 287.84999999999997,
              "endSec": 288.24999999999994,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 288.24999999999994,
              "endSec": 295.6499999999999,
              "text": "Without guardrails, you either supervise every run, or you give the agent side-effect tools and accept unacceptable risk."
            },
            {
              "type": "pause",
              "startSec": 295.6499999999999,
              "endSec": 296.0999999999999,
              "durationSec": 0.45
            },
            {
              "type": "tts",
              "startSec": 296.0999999999999,
              "endSec": 308.19999999999993,
              "text": "With staged tools and durable approvals, the agent drafts with read-only tools, a human reviews at a checkpoint, and only after approval does the send tool become available."
            }
          ],
          "bullets": []
        }
      ]
    },
