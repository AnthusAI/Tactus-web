      "cues": [
        {
          "id": "least_privilege",
          "label": "least_privilege",
          "startSec": 192.3,
          "endSec": 225.99999999999997,
          "text": "Tactus enforces least privilege by design, across multiple dimensions. Minimal toolsets: agents get only the tools they need, not a kitchen sink. Curated context: relevant information only, not everything. Network isolation: the runtime is networkless by default. Secretless broker: credentials stay outside, the agent requests work but never holds keys. Temporal gating: tools become available only when the workflow stage requires them.",
          "segments": [
            {
              "type": "tts",
              "startSec": 192.3,
              "endSec": 197.55,
              "text": "Tactus enforces least privilege by design, across multiple dimensions."
            },
            {
              "type": "pause",
              "startSec": 197.55,
              "endSec": 197.95000000000002,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 197.95000000000002,
              "endSec": 203.4,
              "text": "Minimal toolsets: agents get only the tools they need, not a kitchen sink."
            },
            {
              "type": "pause",
