      "cues": [
        {
          "id": "defense_in_depth",
          "label": "defense_in_depth",
          "startSec": 119.75000000000001,
          "endSec": 191.8,
          "text": "This is the philosophy behind Tactus. Guardrails are not add-ons you bolt on later. They're architectural decisions baked into the execution model. No single technique solves everything. Guardrails work as defense in depth: layers that each reduce a different class of risk. At the top: cost and limits. Hard quotas prevent runaway loops before they become billing nightmares. Prompt engineering. Structured instructions guide behavior and reduce error rates. Context engineering. Curated context ensures the model has the right information, not just all information. Model selection. Choose and fine-tune models for specific capabilities and safety profiles. Tool selection. Give the agent only the capabilities it needs, and stage access over time. Code sandboxing. Isolated execution environments prevent unauthorized system access. Container isolation. Ephemeral containers constrain what the runtime can touch and firewall side effects inside the container.",
          "segments": [
            {
              "type": "tts",
              "startSec": 119.75000000000001,
              "endSec": 128.45000000000002,
              "text": "This is the philosophy behind Tactus. Guardrails are not add-ons you bolt on later. They're architectural decisions baked into the execution model."
            },
