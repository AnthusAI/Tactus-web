                "y": 610,
                "size": 40,
                "align": "center",
                "maxWidth": 1500,
                "font": "serif",
                "lineHeight": 1.35,
                "sceneStartSec": 7.75
              }
            }
          ]
        }
      ],
      "cues": [
        {
          "id": "brakes",
          "label": "brakes",
          "startSec": 8.25,
          "endSec": 37.15,
          "text": "Picture a Formula One car with its brake system removed. Lighter. Simpler. Fewer things to go wrong. You'd crash on the first turn. The best racing teams don't debate whether brakes slow them down. They know something deeper: brakes are what let you go fast in the first place. That's the paradox of agent autonomy. Guardrails are not a limitation on autonomy — they're the prerequisite for it.",
