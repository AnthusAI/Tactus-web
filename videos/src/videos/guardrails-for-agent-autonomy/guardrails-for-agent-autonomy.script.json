            {
              "id": "text-block-5",
              "type": "TextBlock",
              "props": {
                "text": "Delegation requires boundaries: budgets, approval gates, audits, and reviews. Constraints enable autonomy.",
                "x": 1560,
                "y": 560,
                "size": 34,
                "align": "center",
                "maxWidth": 420,
