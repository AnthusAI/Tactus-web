            {
              "id": "text-block-0",
              "type": "TextBlock",
              "props": {
                "text": "Many teams already add guardrails in Python - schemas, validation, retries, approval gates, sandboxing, secrets hygiene.\\n\\nBut it is easy to miss a layer when you assemble everything by convention across mismatched systems.\\n\\n• Tool schemas and deterministic validation\\n• Policy enforcement (allowlists, limits, invariants)\\n• Approval gates for irreversible actions\\n• Sandboxing and isolation for code and files\\n• Secrets isolation to prevent credential theft",
                "x": 960,
                "y": 620,
                "size": 36,
                "align": "center",
                "maxWidth": 1500,
                "font": "serif",
                "lineHeight": 1.35,
                "sceneStartSec": 90.85000000000001
              }
            }
          ]
        }
      ],
      "cues": [
        {
