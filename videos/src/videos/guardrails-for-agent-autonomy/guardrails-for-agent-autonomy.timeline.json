      "seconds": 0.25
    },
    {
      "type": "tts",
      "sceneId": "guardrails-for-agent-autonomy",
      "cueId": "title",
      "startSec": 0.25,
      "endSec": 5.4,
      "segments": [
        {
          "type": "pause",
          "startSec": 0.25,
          "endSec": 0.95,
          "seconds": 0.7
        },
        {
          "type": "tts",
          "startSec": 0.95,
          "endSec": 2.4045454545454543,
          "text": "Guardrails for agent autonomy.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-for-agent-autonomy--title--tts--06c5716673d2--1.wav",
          "durationSec": 1.4545454545454546,
          "rawDurationSec": 1.4545454545454546,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 2.4045454545454543,
          "endSec": 2.8545454545454545,
          "seconds": 0.45
        },
        {
          "type": "tts",
          "startSec": 2.8545454545454545,
          "endSec": 5.4,
          "text": "Why you can't drive fast without brakes.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-for-agent-autonomy--title--tts--3a18e0af4088--1.wav",
          "durationSec": 2.5454545454545454,
          "rawDurationSec": 2.5454545454545454,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "the-paradox-of-power",
      "cueId": "brakes",
      "startSec": 5.9,
      "endSec": 32.127272727272725,
      "segments": [
        {
          "type": "tts",
          "startSec": 5.9,
          "endSec": 12.081818181818182,
          "text": "Picture a Formula One car with its brake system removed. Lighter. Simpler. Fewer things to go wrong.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-paradox-of-power--brakes--tts--48f0b547320a--1.wav",
          "durationSec": 6.181818181818182,
          "rawDurationSec": 6.181818181818182,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 12.081818181818182,
          "endSec": 12.581818181818182,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 12.581818181818182,
          "endSec": 14.763636363636364,
          "text": "You'd crash on the first turn.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-paradox-of-power--brakes--tts--07e597d15883--1.wav",
          "durationSec": 2.1818181818181817,
          "rawDurationSec": 2.1818181818181817,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 14.763636363636364,
          "endSec": 15.213636363636363,
          "seconds": 0.45
        },
        {
          "type": "tts",
          "startSec": 15.213636363636363,
          "endSec": 24.668181818181814,
          "text": "The best racing teams don't debate whether brakes slow them down. They know something deeper: brakes are what let you go fast in the first place.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-paradox-of-power--brakes--tts--2f6d53054411--1.wav",
          "durationSec": 9.454545454545453,
          "rawDurationSec": 9.454545454545453,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 24.668181818181814,
          "endSec": 25.218181818181815,
          "seconds": 0.55
        },
        {
          "type": "tts",
          "startSec": 25.218181818181815,
          "endSec": 32.127272727272725,
          "text": "That's the paradox of agent autonomy. Guardrails are not a limitation on autonomy — they're the prerequisite for it.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-paradox-of-power--brakes--tts--f8f4740bacda--1.wav",
          "durationSec": 6.909090909090909,
          "rawDurationSec": 6.909090909090909,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "the-pattern-repeats-across-domains",
      "cueId": "patterns",
      "startSec": 32.627272727272725,
      "endSec": 55.345454545454544,
      "segments": [
        {
          "type": "tts",
          "startSec": 32.627272727272725,
          "endSec": 36.263636363636365,
          "text": "This pattern repeats everywhere humans have built powerful, autonomous systems.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-pattern-repeats-across-domains--patterns--tts--27b32f6bbc1c--1.wav",
          "durationSec": 3.6363636363636367,
          "rawDurationSec": 3.6363636363636367,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 36.263636363636365,
          "endSec": 36.663636363636364,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 36.663636363636364,
          "endSec": 48.663636363636364,
          "text": "Aviation scaled autonomy by adding checklists, hard limits, and layered safety. Medicine made protocols standard because expertise alone isn't enough under pressure. Organizations delegate power safely by creating budgets, approvals, audits, and reviews.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-pattern-repeats-across-domains--patterns--tts--e778a1c7a13c--1.wav",
          "durationSec": 12,
          "rawDurationSec": 12,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 48.663636363636364,
          "endSec": 49.163636363636364,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 49.163636363636364,
          "endSec": 55.345454545454544,
          "text": "The more powerful the actor, the more critical the guardrails. AI isn't special — it's just newer.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-pattern-repeats-across-domains--patterns--tts--9de60e23484a--1.wav",
          "durationSec": 6.181818181818182,
          "rawDurationSec": 6.181818181818182,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "the-prompt-engineering-ceiling",
      "cueId": "prompt_ceiling",
      "startSec": 55.845454545454544,
      "endSec": 76.0181818181818,
      "segments": [
        {
          "type": "tts",
          "startSec": 55.845454545454544,
          "endSec": 59.11818181818182,
          "text": "Prompts matter. They shape behavior and reduce error rates.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-prompt-engineering-ceiling--prompt_ceiling--tts--a3f968609593--1.wav",
          "durationSec": 3.2727272727272725,
          "rawDurationSec": 3.2727272727272725,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 59.11818181818182,
          "endSec": 59.518181818181816,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 59.518181818181816,
          "endSec": 70.79090909090908,
          "text": "But prompts are suggestions, not controls. When an agent has access to powerful tools, you eventually hit a ceiling. You can make failure less likely, but you can't make it vanish.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-prompt-engineering-ceiling--prompt_ceiling--tts--256db967a37a--1.wav",
          "durationSec": 11.272727272727272,
          "rawDurationSec": 11.272727272727272,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 70.79090909090908,
          "endSec": 71.29090909090908,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 71.29090909090908,
          "endSec": 76.0181818181818,
          "text": "Production safety can't be built out of suggestions alone. You need enforceable boundaries.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-prompt-engineering-ceiling--prompt_ceiling--tts--29469a77c6e0--1.wav",
          "durationSec": 4.727272727272727,
          "rawDurationSec": 4.727272727272727,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "the-manual-assembly-problem",
      "cueId": "manual_assembly",
      "startSec": 76.5181818181818,
      "endSec": 98.45909090909092,
      "segments": [
        {
          "type": "tts",
          "startSec": 76.5181818181818,
          "endSec": 82.69999999999999,
          "text": "The best teams already add guardrails in Python: schemas, validation, retries, approval gates, sandboxing, and secrets hygiene.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-manual-assembly-problem--manual_assembly--tts--c929cb435316--1.wav",
          "durationSec": 6.181818181818182,
          "rawDurationSec": 6.181818181818182,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 82.69999999999999,
          "endSec": 83.1,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 83.1,
          "endSec": 93.28181818181818,
          "text": "The problem isn't that people don't know guardrails matter. The problem is that when you assemble everything by convention across mismatched systems, it's easy to miss a layer.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-manual-assembly-problem--manual_assembly--tts--8c9df113ac09--1.wav",
          "durationSec": 10.181818181818182,
          "rawDurationSec": 10.181818181818182,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 93.28181818181818,
          "endSec": 93.73181818181818,
          "seconds": 0.45
        },
        {
          "type": "tts",
          "startSec": 93.73181818181818,
          "endSec": 98.45909090909092,
          "text": "Missing a layer won't feel like a mistake until it becomes an incident.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/the-manual-assembly-problem--manual_assembly--tts--589cebfd6198--1.wav",
          "durationSec": 4.727272727272727,
          "rawDurationSec": 4.727272727272727,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "guardrails-as-first-class-architecture",
      "cueId": "defense_in_depth",
      "startSec": 98.95909090909092,
      "endSec": 151.76363636363638,
      "segments": [
        {
          "type": "tts",
          "startSec": 98.95909090909092,
          "endSec": 106.95909090909092,
          "text": "This is the philosophy behind Tactus. Guardrails are not add-ons you bolt on later. They're architectural decisions baked into the execution model.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--ffc8b8dd161d--1.wav",
          "durationSec": 8,
          "rawDurationSec": 8,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 106.95909090909092,
          "endSec": 107.45909090909092,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 107.45909090909092,
          "endSec": 114.7318181818182,
          "text": "No single technique solves everything. Guardrails work as defense in depth: layers that each reduce a different class of risk.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--4e46beaa86fa--1.wav",
          "durationSec": 7.272727272727273,
          "rawDurationSec": 7.272727272727273,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 114.7318181818182,
          "endSec": 115.1318181818182,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 115.1318181818182,
          "endSec": 120.95000000000002,
          "text": "At the top: cost and limits. Hard quotas prevent runaway loops before they become billing nightmares.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--7d93ed862483--1.wav",
          "durationSec": 5.818181818181818,
          "rawDurationSec": 5.818181818181818,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 120.95000000000002,
          "endSec": 121.30000000000001,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 121.30000000000001,
          "endSec": 124.93636363636365,
          "text": "Prompt engineering. Structured instructions guide behavior and reduce error rates.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--899d650efe11--1.wav",
          "durationSec": 3.6363636363636367,
          "rawDurationSec": 3.6363636363636367,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 124.93636363636365,
          "endSec": 125.28636363636365,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 125.28636363636365,
          "endSec": 130.7409090909091,
          "text": "Context engineering. Curated context ensures the model has the right information, not just all information.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--b62b12e5f7ea--1.wav",
          "durationSec": 5.454545454545455,
          "rawDurationSec": 5.454545454545455,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 130.7409090909091,
          "endSec": 131.0909090909091,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 131.0909090909091,
          "endSec": 135.45454545454547,
          "text": "Model selection. Choose and fine-tune models for specific capabilities and safety profiles.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--d9ab718598b6--1.wav",
          "durationSec": 4.363636363636363,
          "rawDurationSec": 4.363636363636363,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 135.45454545454547,
          "endSec": 135.80454545454546,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 135.80454545454546,
          "endSec": 141.25909090909093,
          "text": "Tool selection. Give the agent only the capabilities it needs, and stage access over time.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--e98818539b28--1.wav",
          "durationSec": 5.454545454545455,
          "rawDurationSec": 5.454545454545455,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 141.25909090909093,
          "endSec": 141.60909090909092,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 141.60909090909092,
          "endSec": 144.8818181818182,
          "text": "Code sandboxing. Isolated execution environments prevent unauthorized system access.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--ed73f4e541f5--1.wav",
          "durationSec": 3.2727272727272725,
          "rawDurationSec": 3.2727272727272725,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 144.8818181818182,
          "endSec": 145.2318181818182,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 145.2318181818182,
          "endSec": 151.41363636363639,
          "text": "Container isolation. Ephemeral containers constrain what the runtime can touch and firewall side effects inside the container.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/guardrails-as-first-class-architecture--defense_in_depth--tts--721523056378--1.wav",
          "durationSec": 6.181818181818182,
          "rawDurationSec": 6.181818181818182,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 151.41363636363639,
          "endSec": 151.76363636363638,
          "seconds": 0.35
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "least-privilege-by-design",
      "cueId": "least_privilege",
      "startSec": 152.26363636363638,
      "endSec": 176.6090909090909,
      "segments": [
        {
          "type": "tts",
          "startSec": 152.26363636363638,
          "endSec": 155.53636363636366,
          "text": "Tactus enforces least privilege by design, across multiple dimensions.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/least-privilege-by-design--least_privilege--tts--5f6112b370ef--1.wav",
          "durationSec": 3.2727272727272725,
          "rawDurationSec": 3.2727272727272725,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 155.53636363636366,
          "endSec": 155.93636363636367,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 155.93636363636367,
          "endSec": 160.66363636363639,
          "text": "Minimal toolsets: agents get only the tools they need, not a kitchen sink.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/least-privilege-by-design--least_privilege--tts--c366926d3549--1.wav",
          "durationSec": 4.727272727272727,
          "rawDurationSec": 4.727272727272727,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 160.66363636363639,
          "endSec": 161.01363636363638,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 161.01363636363638,
          "endSec": 163.5590909090909,
          "text": "Curated context: relevant information only, not everything.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/least-privilege-by-design--least_privilege--tts--a5baea843a89--1.wav",
          "durationSec": 2.5454545454545454,
          "rawDurationSec": 2.5454545454545454,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 163.5590909090909,
          "endSec": 163.9090909090909,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 163.9090909090909,
          "endSec": 166.8181818181818,
          "text": "Network isolation: the runtime is networkless by default.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/least-privilege-by-design--least_privilege--tts--c2ef8bf77a5a--1.wav",
          "durationSec": 2.909090909090909,
          "rawDurationSec": 2.909090909090909,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 166.8181818181818,
          "endSec": 167.1681818181818,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 167.1681818181818,
          "endSec": 171.89545454545453,
          "text": "Secretless broker: credentials stay outside, the agent requests work but never holds keys.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/least-privilege-by-design--least_privilege--tts--3476f9c5bb27--1.wav",
          "durationSec": 4.727272727272727,
          "rawDurationSec": 4.727272727272727,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 171.89545454545453,
          "endSec": 172.24545454545452,
          "seconds": 0.35
        },
        {
          "type": "tts",
          "startSec": 172.24545454545452,
          "endSec": 176.6090909090909,
          "text": "Temporal gating: tools become available only when the workflow stage requires them.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/least-privilege-by-design--least_privilege--tts--3c84a041f4e3--1.wav",
          "durationSec": 4.363636363636363,
          "rawDurationSec": 4.363636363636363,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "sandboxing-a-secretless-broker-boundary",
      "cueId": "sandbox_broker",
      "startSec": 177.1090909090909,
      "endSec": 224.7409090909091,
      "segments": [
        {
          "type": "tts",
          "startSec": 177.1090909090909,
          "endSec": 188.38181818181818,
          "text": "Once you let an agent write files or run code, you want a cage. Tactus runs orchestration inside a sandboxed Lua environment, and when sandboxing is enabled, inside an ephemeral container.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/sandboxing-a-secretless-broker-boundary--sandbox_broker--tts--397d870aa1a8--1.wav",
          "durationSec": 11.272727272727272,
          "rawDurationSec": 11.272727272727272,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 188.38181818181818,
          "endSec": 188.88181818181818,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 188.88181818181818,
          "endSec": 195.79090909090908,
          "text": "But containers answer only one security question: what can it touch? The other question is: what can it steal?",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/sandboxing-a-secretless-broker-boundary--sandbox_broker--tts--f70414b10493--1.wav",
          "durationSec": 6.909090909090909,
          "rawDurationSec": 6.909090909090909,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 195.79090909090908,
          "endSec": 196.29090909090908,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 196.29090909090908,
          "endSec": 209.74545454545455,
          "text": "The broker boundary is the game changer. Keep the runtime secretless and networkless by default. The sandbox can request tool calls, but it never holds provider keys. The keys live outside the sandbox, in a trusted broker.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/sandboxing-a-secretless-broker-boundary--sandbox_broker--tts--8dd983320f50--1.wav",
          "durationSec": 13.454545454545455,
          "rawDurationSec": 13.454545454545455,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 209.74545454545455,
          "endSec": 210.19545454545454,
          "seconds": 0.45
        },
        {
          "type": "tts",
          "startSec": 210.19545454545454,
          "endSec": 224.7409090909091,
          "text": "This is the security model: don't make secrets hard to steal—make sure there are no secrets inside the runtime to steal. It's like letting a burglar into an empty building. Even if they get in, there's nothing valuable to take.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/sandboxing-a-secretless-broker-boundary--sandbox_broker--tts--d62067a75310--1.wav",
          "durationSec": 14.545454545454547,
          "rawDurationSec": 14.545454545454547,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "a-concrete-example",
      "cueId": "recap_emails",
      "startSec": 225.2409090909091,
      "endSec": 247.1818181818182,
      "segments": [
        {
          "type": "tts",
          "startSec": 225.2409090909091,
          "endSec": 229.60454545454547,
          "text": "Consider a workflow that drafts and sends recap emails from meeting notes.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/a-concrete-example--recap_emails--tts--f1aa09cfa6ff--1.wav",
          "durationSec": 4.363636363636363,
          "rawDurationSec": 4.363636363636363,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 229.60454545454547,
          "endSec": 230.00454545454548,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 230.00454545454548,
          "endSec": 236.55,
          "text": "Without guardrails, you either supervise every run, or you give the agent side-effect tools and accept unacceptable risk.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/a-concrete-example--recap_emails--tts--6f6b0ae16455--1.wav",
          "durationSec": 6.545454545454545,
          "rawDurationSec": 6.545454545454545,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 236.55,
          "endSec": 237,
          "seconds": 0.45
        },
        {
          "type": "tts",
          "startSec": 237,
          "endSec": 247.1818181818182,
          "text": "With staged tools and durable approvals, the agent drafts with read-only tools, a human reviews at a checkpoint, and only after approval does the send tool become available.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/a-concrete-example--recap_emails--tts--d1d1e9fdccf1--1.wav",
          "durationSec": 10.181818181818182,
          "rawDurationSec": 10.181818181818182,
          "trimEndSec": 0
        }
      ]
    },
    {
      "type": "tts",
      "sceneId": "closing",
      "cueId": "closing",
      "startSec": 247.6818181818182,
      "endSec": 261.6727272727273,
      "segments": [
        {
          "type": "tts",
          "startSec": 247.6818181818182,
          "endSec": 250.95454545454547,
          "text": "Guardrails aren't a tax. They're the engine of delegation.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/closing--closing--tts--a2272b6e6002--1.wav",
          "durationSec": 3.2727272727272725,
          "rawDurationSec": 3.2727272727272725,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 250.95454545454547,
          "endSec": 251.35454545454547,
          "seconds": 0.4
        },
        {
          "type": "tts",
          "startSec": 251.35454545454547,
          "endSec": 257.53636363636366,
          "text": "The race car needs brakes. The surgeon needs protocols. The organization needs governance. The agent needs guardrails.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/closing--closing--tts--7e6066046284--1.wav",
          "durationSec": 6.181818181818182,
          "rawDurationSec": 6.181818181818182,
          "trimEndSec": 0
        },
        {
          "type": "pause",
          "startSec": 257.53636363636366,
          "endSec": 258.03636363636366,
          "seconds": 0.5
        },
        {
          "type": "tts",
          "startSec": 258.03636363636366,
          "endSec": 261.6727272727273,
          "text": "Read the full story at tactus dot run slash guardrails.",
          "segmentPath": "/Users/ryan.porter/Projects/Tactus-web/videos/.videoml/out/guardrails-for-agent-autonomy/env/development/segments/closing--closing--tts--131ae547b6c1--1.wav",
          "durationSec": 3.6363636363636367,
          "rawDurationSec": 3.6363636363636367,
          "trimEndSec": 0
        }
      ]
    }
  ],
