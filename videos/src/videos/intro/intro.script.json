        {
          "id": "diagram",
          "zIndex": 0,
          "components": [
            {
              "id": "container-sandbox-diagram-0",
              "type": "ContainerSandboxDiagram",
              "props": {
                "containerWidth": 1400,
                "containerHeight": 650,
                "x": 960,
