      ],
      "cues": [
        {
          "id": "sandboxing",
          "label": "Sandboxing",
          "startSec": 289.0290909090908,
          "endSec": 340.610909090909,
          "text": "We know AI models make mistakes. Maybe your agent writes buggy tool code. Or maybe an attacker uses a prompt injection to hijack the agent and try something malicious. You want agents that can write files and run programs—they need to be powerful and useful. But you don't want them reaching out to the network or deleting files on your server. Tactus runs agent code in a restricted Lua sandbox inside a networkless container. The agent can do real work, but it can't vandalize your system or phone home to some attacker's website. The other risk is credentials. Your procedure might need keys to call third-party services, but you don't want the agent to see them. Tactus keeps secrets outside the container in a separate process. Even if something goes wrong, there's nothing for the agent to steal.",
          "segments": [
            {
              "type": "tts",
              "startSec": 289.0290909090908,
              "endSec": 299.5745454545454,
              "text": "We know AI models make mistakes. Maybe your agent writes buggy tool code. Or maybe an attacker uses a prompt injection to hijack the agent and try something malicious."
            },
            {
              "type": "pause",
              "startSec": 299.5745454545454,
              "endSec": 299.97454545454536,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 299.97454545454536,
              "endSec": 311.610909090909,
              "text": "You want agents that can write files and run programs—they need to be powerful and useful. But you don't want them reaching out to the network or deleting files on your server."
            },
            {
              "type": "pause",
              "startSec": 311.610909090909,
              "endSec": 312.110909090909,
              "durationSec": 0.5
            },
            {
              "type": "tts",
              "startSec": 312.110909090909,
              "endSec": 323.7472727272726,
              "text": "Tactus runs agent code in a restricted Lua sandbox inside a networkless container. The agent can do real work, but it can't vandalize your system or phone home to some attacker's website."
            },
            {
              "type": "pause",
              "startSec": 323.7472727272726,
              "endSec": 324.2472727272726,
              "durationSec": 0.5
            },
            {
              "type": "tts",
              "startSec": 324.2472727272726,
              "endSec": 340.610909090909,
              "text": "The other risk is credentials. Your procedure might need keys to call third-party services, but you don't want the agent to see them. Tactus keeps secrets outside the container in a separate process. Even if something goes wrong, there's nothing for the agent to steal."
            }
          ],
          "bullets": []
