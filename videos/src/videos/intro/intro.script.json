      "cues": [
        {
          "id": "defense_layers",
          "label": "Defense Layers",
          "startSec": 247.4472727272728,
          "endSec": 288.5290909090908,
          "text": "Tactus gives you multiple types of control. Because no single type is sufficient on its own. Prompt engineering guides model behavior, but it's not enough on its own. Cost and limits block requests before they hit the model—preventing runaway loops and billing surprises. Context engineering ensures the model has the right information, not just all information. Model selection for the right capabilities and safety profiles. Tool selection. Give the agent only the capabilities it needs. Code sandboxing. Running agent code in a restricted environment so it can't cause damage. And container isolation. Firewalling agent activity so it can't reach the network or touch your server.",
          "segments": [
            {
              "type": "tts",
              "startSec": 247.4472727272728,
              "endSec": 253.26545454545462,
              "text": "Tactus gives you multiple types of control. Because no single type is sufficient on its own."
            },
            {
              "type": "pause",
