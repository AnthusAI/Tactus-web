        {
          "id": "prompt_ceiling_intro",
          "label": "Prompt Ceiling",
          "startSec": 215.129090909091,
          "endSec": 246.9472727272728,
          "text": "To operate confidently in production—safely and securely—you need a minimum threshold of reliability. The obvious first type of control that everyone reaches for is prompt engineering. But prompts are suggestions, not controls. There are things you just can't reliably make a model do or not do with prompts alone. There's a gap between what you can achieve with prompt engineering and the minimum reliability you need to run at scale in production. To close that gap, you need different types of control.",
          "segments": [
            {
              "type": "tts",
              "startSec": 215.129090909091,
              "endSec": 219.8563636363637,
