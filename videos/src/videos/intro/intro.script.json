      "cues": [
        {
          "id": "interface_supervised",
          "label": "Closely Supervised",
          "startSec": 94.03818181818181,
          "endSec": 131.6018181818182,
          "text": "Connecting to agents and tools is just the beginning. The real challenge is the interface layer between the agent and the operator. The common interface for agents today is chat. You watch every step, you steer, and you stop the agent if it goes sideways. That works great for some things but depends on the human operator. The user becomes a bottleneck. When you step away to eat or sleep, the whole system stops doing anything. If you're trying to process a lot of items at scale then your capacity is limited by the human operator.You can't scale this up.",
          "segments": [
            {
              "type": "tts",
              "startSec": 94.03818181818181,
              "endSec": 102.03818181818181,
              "text": "Connecting to agents and tools is just the beginning. The real challenge is the interface layer between the agent and the operator."
            },
            {
              "type": "pause",
              "startSec": 102.03818181818181,
              "endSec": 102.43818181818182,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 102.43818181818182,
              "endSec": 115.16545454545455,
              "text": "The common interface for agents today is chat. You watch every step, you steer, and you stop the agent if it goes sideways. That works great for some things but depends on the human operator."
            },
            {
              "type": "pause",
              "startSec": 115.16545454545455,
              "endSec": 115.56545454545456,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 115.56545454545456,
              "endSec": 131.2018181818182,
              "text": "The user becomes a bottleneck. When you step away to eat or sleep, the whole system stops doing anything. If you're trying to process a lot of items at scale then your capacity is limited by the human operator.You can't scale this up."
            },
            {
              "type": "pause",
              "startSec": 131.2018181818182,
              "endSec": 131.6018181818182,
              "durationSec": 0.4
            }
          ],
          "bullets": []
        },
        {
          "id": "interface_unsupervised",
          "label": "Unsupervised",
          "startSec": 131.6018181818182,
          "endSec": 150.22000000000006,
          "text": "You could remove the human entirely and let the agent run free. This scales beautifully—you can process thousands of items at machine speed. But running an agent this way is like giving a monkey a razor blade. And scaling that up to industrial levels is a recipe for disaster.",
          "segments": [
            {
              "type": "tts",
              "startSec": 131.6018181818182,
              "endSec": 139.96545454545458,
              "text": "You could remove the human entirely and let the agent run free. This scales beautifully—you can process thousands of items at machine speed."
            },
            {
              "type": "pause",
              "startSec": 139.96545454545458,
              "endSec": 140.36545454545458,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 140.36545454545458,
              "endSec": 149.82000000000005,
              "text": "But running an agent this way is like giving a monkey a razor blade. And scaling that up to industrial levels is a recipe for disaster."
            },
            {
              "type": "pause",
              "startSec": 149.82000000000005,
              "endSec": 150.22000000000006,
              "durationSec": 0.4
            }
          ],
          "bullets": []
        },
        {
          "id": "interface_hitl",
          "label": "Durable HITL",
          "startSec": 150.22000000000006,
          "endSec": 188.8381818181819,
          "text": "Tactus provides a new interface layer between the human and the computer. It enables agents to send requests to the human operator and wait for a response. Requests can queue up, so that the system can continue running while the human operator isn't available. When a procedure needs a human—to approve a risky action, or to provide a missing detail—it pauses. It doesn't use any compute while it's suspended, and it doesn't depend on the runtime to continue running in memory. It can resume hours or days later, exactly where it left off. This lets you move from synchronous chat to asynchronous, industrial-scale workflows.",
          "segments": [
            {
              "type": "tts",
              "startSec": 150.22000000000006,
              "endSec": 166.22000000000006,
              "text": "Tactus provides a new interface layer between the human and the computer. It enables agents to send requests to the human operator and wait for a response. Requests can queue up, so that the system can continue running while the human operator isn't available."
            },
            {
              "type": "pause",
              "startSec": 166.22000000000006,
              "endSec": 166.62000000000006,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 166.62000000000006,
              "endSec": 180.07454545454553,
              "text": "When a procedure needs a human—to approve a risky action, or to provide a missing detail—it pauses. It doesn't use any compute while it's suspended, and it doesn't depend on the runtime to continue running in memory."
            },
            {
              "type": "pause",
              "startSec": 180.07454545454553,
              "endSec": 180.47454545454553,
              "durationSec": 0.4
            },
            {
