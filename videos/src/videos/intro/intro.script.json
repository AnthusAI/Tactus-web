              "type": "pause",
              "startSec": 263.98363636363644,
              "endSec": 264.3836363636364,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 264.3836363636364,
              "endSec": 269.11090909090916,
              "text": "Context engineering ensures the model has the right information, not just all information."
            },
            {
              "type": "pause",
              "startSec": 269.11090909090916,
              "endSec": 269.51090909090914,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 269.51090909090914,
              "endSec": 272.7836363636364,
              "text": "Model selection for the right capabilities and safety profiles."
            },
            {
              "type": "pause",
              "startSec": 272.7836363636364,
              "endSec": 273.18363636363637,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 273.18363636363637,
              "endSec": 276.82,
              "text": "Tool selection. Give the agent only the capabilities it needs."
            },
            {
              "type": "pause",
              "startSec": 276.82,
              "endSec": 277.21999999999997,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 277.21999999999997,
              "endSec": 282.31090909090904,
              "text": "Code sandboxing. Running agent code in a restricted environment so it can't cause damage."
            },
            {
              "type": "pause",
              "startSec": 282.31090909090904,
              "endSec": 282.710909090909,
              "durationSec": 0.4
            },
            {
              "type": "tts",
              "startSec": 282.710909090909,
              "endSec": 288.5290909090908,
              "text": "And container isolation. Firewalling agent activity so it can't reach the network or touch your server."
            }
          ],
          "bullets": []
        }
      ]
    },
    {
      "id": "sandboxing",
      "title": "Sandboxing",
      "startSec": 289.0290909090908,
